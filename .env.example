# ---------------------------------------------------------------------------
# Contact form email delivery (see README.md → "Wiring up email")
# ---------------------------------------------------------------------------
# Resend API key. When this is absent the /api/contact route still validates and
# accepts submissions, but only logs them to the server console instead of
# sending mail. Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address Resend sends as. Must be on a domain you have verified in
# Resend. onboarding@resend.dev works for testing without a verified domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=hello.technohub@gmail.com

# Absolute site URL, used for canonical + Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://technohub.lk
